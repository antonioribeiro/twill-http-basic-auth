{
    "name": "area17/twill-http-basic-auth",
    "description": "A Twill capsule that puts HTTP Basic Auth in front of a site or of chosen hosts (staging, the admin), with credentials from .env or from the admin.",
    "keywords": [
        "twill",
        "laravel",
        "basic-auth",
        "http-basic-auth",
        "staging",
        "security"
    ],
    "homepage": "https://github.com/antonioribeiro/twill-http-basic-auth",
    "license": "Apache-2.0",
    "require": {
        "php": ">=8.3",
        "area17/twill": "^3.5",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "A17\\TwillHttpBasicAuth\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "A17\\TwillHttpBasicAuth\\Tests\\": "Tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "A17\\TwillHttpBasicAuth\\ServiceProvider"
            ]
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "npx husky"
        ],
        "lint": "sh tools/linters.sh lint",
        "test": "vendor/bin/phpunit"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
