includes:
    - ./vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - src
        - Tests

    level: max

    ignoreErrors:
        # The package's own config file legitimately reads env(): it is a config file even though it sits outside
        # the host application's config/ directory.
        -
            identifier: larastan.noEnvCallsOutsideOfConfig
            path: src/config/*

    reportUnmatchedIgnoredErrors: false
